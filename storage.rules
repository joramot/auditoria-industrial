rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // =====================================================
    // FUNCIONES AUXILIARES
    // =====================================================
    
    // Verificar si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Obtener datos del usuario desde Firestore (con manejo de errores)
    function getUserData() {
      let userPath = /databases/(default)/documents/users/$(request.auth.uid);
      return firestore.get(userPath);
    }
    
    // Verificar si el usuario tiene un documento en Firestore
    function userExists() {
      return getUserData() != null;
    }
    
    // Obtener rol del usuario de forma segura (retorna null si no existe)
    function getUserRole() {
      return userExists() ? getUserData().data.role : null;
    }
    
    // Verificar si el usuario tiene un rol asignado
    function hasRole() {
      return getUserRole() != null;
    }
    
    // Verificar roles específicos
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }
    
    function isSupervisor() {
      return isAuthenticated() && getUserRole() == 'supervisor';
    }
    
    function isAuditor() {
      return isAuthenticated() && getUserRole() == 'auditor';
    }
    
    // Verificar si puede subir archivos (Admin, Supervisor, o sin rol asignado)
    function canUpload() {
      return isAuthenticated() && (
        !hasRole() ||           // Usuario sin rol = permitir (transición)
        isAdmin() || 
        isSupervisor()
      );
    }
    
    // Verificar si puede eliminar archivos
    function canDelete() {
      return isAuthenticated() && (
        !hasRole() ||           // Usuario sin rol = permitir (transición)
        isAdmin() || 
        isSupervisor()
      );
    }
    
    // Verificar tamaño del archivo (máximo 20MB para PDFs, 10MB para imágenes)
    function validImageSize() {
      return request.resource.size <= 10 * 1024 * 1024;
    }
    
    function validPDFSize() {
      return request.resource.size <= 20 * 1024 * 1024;
    }
    
    // Verificar tipo de archivo para imágenes
    function validImageType() {
      return request.resource.contentType.matches('image/.*');
    }
    
    // Verificar tipo de archivo para PDFs
    function validPDFType() {
      return request.resource.contentType == 'application/pdf';
    }
    
    // =====================================================
    // REGLAS PARA IMÁGENES DE EQUIPOS
    // Path: equipment_images/{plantId}/{equipmentId}/{imageType}/{filename}
    // =====================================================
    
    match /equipment_images/{plantId}/{equipmentId}/{imageType}/{filename} {
      // Lectura: Todos los usuarios autenticados
      allow read: if isAuthenticated();
      
      // Escritura: Admin, Supervisor, o usuarios sin rol (transición)
      allow write: if canUpload() && 
                     validImageType() && 
                     validImageSize();
      
      // Eliminación: Admin, Supervisor, o usuarios sin rol (transición)
      allow delete: if canDelete();
    }
    
    // =====================================================
    // REGLAS PARA PDFs EN ESTRUCTURA PLANTAS/EQUIPOS
    // Path: plantas/{plantId}/equipos/{equipmentId}/documentos/{docType}/{filename}
    // =====================================================
    
    match /plantas/{plantId}/equipos/{equipmentId}/documentos/{docType}/{filename} {
      // Lectura: Todos los usuarios autenticados
      allow read: if isAuthenticated();
      
      // Escritura: Admin, Supervisor, o usuarios sin rol (transición)
      allow write: if canUpload() && 
                     validPDFType() && 
                     validPDFSize();
      
      // Eliminación: Admin, Supervisor, o usuarios sin rol (transición)
      allow delete: if canDelete();
    }
    
    // =====================================================
    // REGLAS ALTERNATIVAS (paths antiguos - por compatibilidad)
    // Path: plants/{plantId}/equipment/{equipmentId}/{allPaths}
    // =====================================================
    
    match /plants/{plantId}/equipment/{equipmentId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if canUpload() && validImageSize();
      allow delete: if canDelete();
    }
    
    // =====================================================
    // REGLAS PARA REPORTES GENERADOS
    // Path: reports/{userId}/{reportType}/{filename}
    // =====================================================
    
    match /reports/{userId}/{reportType}/{filename} {
      // Lectura: Admin, Auditor, o el dueño del reporte
      allow read: if isAuthenticated() && (
                    isAdmin() ||
                    isAuditor() ||
                    request.auth.uid == userId
                  );
      
      // Escritura: El usuario puede crear sus propios reportes
      allow write: if isAuthenticated() && 
                     request.auth.uid == userId;
      
      // Eliminación: Admin o el dueño
      allow delete: if isAuthenticated() && (
                      isAdmin() ||
                      request.auth.uid == userId
                    );
    }
    
    // =====================================================
    // REGLAS PARA BACKUPS (Solo Admin)
    // Path: backups/{backupTime}/{filename}
    // =====================================================
    
    match /backups/{backupTime}/{filename} {
      // Solo Admin puede acceder a backups
      allow read, write, delete: if isAdmin();
    }
    
    // =====================================================
    // REGLAS PARA ARCHIVOS TEMPORALES
    // Path: temp/{userId}/{filename}
    // =====================================================
    
    match /temp/{userId}/{filename} {
      // Los usuarios solo pueden acceder a sus archivos temporales
      allow read, write, delete: if isAuthenticated() && 
                                   request.auth.uid == userId;
    }
    
    // =====================================================
    // BLOQUEAR TODO LO DEMÁS
    // =====================================================
    
    // Cualquier ruta no especificada está bloqueada
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
